# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored; never commit values.
# Only needed when the site is hosted on Node (Vercel, Netlify, your own box).
# The static GitHub Pages build has no server and ignores all of this.
# ─────────────────────────────────────────────────────────────────────────────

# Booking requests → the restaurant's Google Sheet.
# Both come from tools/sheet-webhook.gs — read the setup notes at the top of it.
#   URL    : the Apps Script "Web app" deployment URL
#   SECRET : the same string you set as SECRET inside that script
# Leave them unset and bookings are still taken and still written to
# .data/reservations.jsonl; they just do not reach the sheet.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Static export only (GitHub Pages). There is no server, so the browser posts
# to Apps Script directly. BOTH OF THESE SHIP INSIDE THE PAGE and anyone who
# views source can read them — that is expected. Use the PUBLIC_KEY from
# tools/sheet-webhook.gs here, never the SECRET. What protects the sheet is
# MAX_PER_HOUR inside that script.
# Leave unset and the booking form falls back to handing the booking to LINE.
NEXT_PUBLIC_SHEET_URL=
NEXT_PUBLIC_SHEET_KEY=

# The site's public address, used for canonical/hreflang/og:url/sitemap/robots.
# Scheme and host only, no trailing slash and no path — the base path is added
# separately. Unset, it falls back to the GitHub Pages host.
NEXT_PUBLIC_SITE_ORIGIN=
