# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored; never commit values.
# Only needed when the site is hosted on Node (Vercel, Netlify, your own box).
# The static GitHub Pages build has no server and ignores all of this.
# ─────────────────────────────────────────────────────────────────────────────

# Booking requests → the restaurant's Google Sheet.
# Both come from tools/sheet-webhook.gs — read the setup notes at the top of it.
#   URL    : the Apps Script "Web app" deployment URL
#   SECRET : the same string you set as SECRET inside that script
# Leave them unset and bookings are still taken and still written to
# .data/reservations.jsonl; they just do not reach the sheet.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
