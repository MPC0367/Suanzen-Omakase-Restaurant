# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. .env.local is gitignored; never commit values.
# ─────────────────────────────────────────────────────────────────────────────

# The site's public address, used for canonical, hreflang and the link preview.
# Scheme and host only, no trailing slash and no path — the base path is added
# separately. Unset, it falls back to the GitHub Pages host. On GitHub the Pages
# workflow sets it from public/CNAME, so this is only for local builds.
NEXT_PUBLIC_SITE_ORIGIN=
