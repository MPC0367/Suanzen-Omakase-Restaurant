# Normalise line endings so the repo is the same on macOS and Windows.
* text=auto eol=lf

# Photographs and fonts are binary — never diff or convert them.
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.woff  binary
*.woff2 binary

# Keep generated content out of diffs and language stats.
src/content/courses.ts linguist-generated=true
src/content/media.ts   linguist-generated=true
qa/**                  linguist-vendored=true
